{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@edison/contracts": ["../packages/contracts/dist"],
      "@edison/contracts/*": ["../packages/contracts/dist/*"]
    }
  },
  "references": [
    { "path": "../packages/contracts" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
