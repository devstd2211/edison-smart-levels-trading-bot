{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./packages/core/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@edison/contracts": ["packages/contracts/dist"],
      "@edison/contracts/*": ["packages/contracts/dist/*"],
      "trading-bot-web-server": ["web-server/dist"],
      "trading-bot-web-server/*": ["web-server/dist/*"]
    }
  },
  "include": ["packages/core/src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "web-server/**", "web-client/**", "packages/core/src/archive/**", "packages/core/src/__tests__/**/*.ARCHIVED.ts"]
}
